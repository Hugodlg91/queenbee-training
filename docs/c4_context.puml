@startuml c4_context
!include <C4/C4_Context>
title Queen Bee — Contexte (C4 niveau 1)

Person(analyst, "Analyste SOC", "Trie les incidents, bloque les IP")
Person(admin, "Administrateur", "Configure règles, seuils et secrets")
Person_Ext(attacker, "Attaquant", "Attaque les hôtes surveillés")

System(qb, "Queen Bee", "Valide les événements, détecte, ouvre et trace les incidents")

System_Ext(agent, "Agents (abeilles)", "Collectent les logs sur les hôtes surveillés")
System_Ext(feed, "Flux de menaces", "Fournisseur externe de réputation d'IP")
System_Ext(siem, "SIEM / SOC", "Reçoit alertes et journal d'audit")
System_Ext(fw, "Pare-feu", "Applique les blocages d'IP")

Rel(attacker, agent, "Laisse des traces piégées dans les logs", "sshd")
